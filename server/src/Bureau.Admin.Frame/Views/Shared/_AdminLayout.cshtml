@using Bureau.Admin.Hosting
@inject IAppsRegistry AppsRegistry

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/assets/frame/css/bureau-admin-frame.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            @await Html.PartialAsync("_AdminSidebar", AppsRegistry)
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <button class="admin-nav-toggle" type="button" id="adminNavToggle" aria-controls="adminSidebar" aria-expanded="false" aria-label="Open menu">
                    <!-- hamburger -->
                    <svg class="icon icon-menu" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 7h14M5 12h14M5 17h14" />
                    </svg>
                </button>
                @await Html.PartialAsync("_AdminHeader")
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
        <div class="admin-backdrop" id="adminBackdrop" hidden></div>
    </div>
    <script src="~/assets/frame/js/bureau-admin-frame.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
