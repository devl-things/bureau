@using Bureau.Admin.Hosting
@inject IAppsRegistry AppsRegistry

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/assets/frame/css/bureau-admin-frame.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            @await Html.PartialAsync("_AdminSidebar", AppsRegistry)
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                @await Html.PartialAsync("_AdminHeader")
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
