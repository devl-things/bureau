@using System
@using Bureau.Admin.Hosting
@model IAppsRegistry

<div class="admin-sidebar-top">
    <div class="admin-brand">
        <div class="admin-nav-title">Bureau</div>
        <div class="admin-nav-subtitle">Admin</div>
    </div>

    <button type="button" class="admin-nav-close" id="adminNavClose" aria-label="Close menu">
        <svg class="icon icon-close" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
        </svg>
    </button>
</div>
<div class="admin-nav">
    <ul class="admin-nav-list">
        @foreach (AppDescriptor app in Model.Apps)
        {
            bool isActive = string.Equals(app.Key, Model.CurrentAppKey, StringComparison.OrdinalIgnoreCase);
            string activeClass = isActive ? "is-active" : string.Empty;

            <li class="admin-nav-item @activeClass">
                <a class="admin-nav-link" href="@app.Url">
                    <span class="admin-nav-text">@app.Title</span>
                </a>
            </li>
        }
    </ul>
</div>
