@using System.Globalization
@using Sven.Configurations
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Sven</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~@StylesScriptNames.ConnectMin" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="connect-layout">
    <main class="connect-container">
        @RenderBody()      
    </main>
    <div class="language-switcher">
        <select id="languageSwitcher" onchange="onLanguageChange(this)">
            <option value="en" selected="@(currentCulture == "en")">English</option>
            <option value="hr" selected="@(currentCulture == "hr")">Hrvatski</option>
        </select>
    </div>
    <script>
        function onLanguageChange(select) {
            const selectedLang = select.value;
            document.cookie = `.AspNetCore.Culture=c=${selectedLang}|uic=${selectedLang}; path=/; max-age=31536000; SameSite=Lax; Secure`; // 1 year
            window.location.reload();
        }
    </script>
</body>
</html>