@using System.Globalization
@{
    string brand = "Sven";
    string currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
@functions {
    bool IsActive(string path, bool exact = false)
    {
        PathString current = ViewContext.HttpContext.Request.Path;
        return exact
            ? string.Equals(current, path, StringComparison.OrdinalIgnoreCase)
            : current.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @brand</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~@StylesScriptNames.SvenMin" asp-append-version="true" />
</head>
<body>
    <div class="sven-layout d-flex min-vh-100">
        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar d-flex flex-column align-items-center">
            <div class="logo-wrapper">
                <img src="~/images/logo.png" alt="@brand Logo" class="logo" asp-append-version=true/>
            </div>
            <nav class="nav flex-column w-100 px-2 mt-4">
                <a class="nav-link @(IsActive("/", exact: true) ? "active" : "")" href="/"><i class="bi bi-house-door"></i> <span class="label">Home</span></a>
                <a class="nav-link @(IsActive(Endpoints.Account.AccountInfo) ? "active" : "")" href="@Endpoints.Account.AccountInfo"><i class="bi bi-person"></i> <span class="label">Account</span></a>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div id="main-content" class="main-content d-flex flex-column flex-grow-1">
            <header class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm ps-2 pe-4">
                <div class="container-fluid d-flex align-items-center">
                    <div class="language-switcher">
                        <select id="languageSwitcher" onchange="onLanguageChange(this)">
                            <option value="en" selected="@(currentCulture == "en")">English</option>
                            <option value="hr" selected="@(currentCulture == "hr")">Hrvatski</option>
                        </select>
                    </div>
                    
                    <button class="hamburger-toggle me-3" onclick="toggleSidebar()" title="Toggle menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="ms-auto">
                        @await Component.InvokeAsync(ViewComponents.UserNav)
                    </div>
                </div>
            </header>

            <main class="container-fluid flex-grow-1 py-4">
                @RenderBody()
            </main>

            <footer class="container border-top pt-3 text-muted small text-center mt-auto">
                &copy; @DateTime.Now.Year @brand Identity. All rights reserved.
            </footer>
        </div>
    </div>


    <environment names="Development">
        <script src="/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
        <script src="/js/layout.js" asp-append-version="true"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~@JsScriptNames.SvenMin" asp-append-version="true"></script>
    </environment>
    <script>
        function onLanguageChange(select) {
            const selectedLang = select.value;
            document.cookie = `.AspNetCore.Culture=c=${selectedLang}|uic=${selectedLang}; path=/; max-age=31536000; SameSite=Lax; Secure`; // 1 year
            window.location.reload();
        }
    </script>
    @await RenderSectionAsync("ScriptsFooter", required: false)
</body>
</html>