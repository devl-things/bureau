@page "/connect/authorize/page"
@using Sven.Configurations
@model Sven.Pages.Connect.AuthorizeModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Login - Sven Identity</title>
</head>
<body>
    <h2>Login</h2>

    <form method="post" action="@Endpoints.Connect.AuthorizeLogin">
        <input type="text" name="username" placeholder="Username" required />
        <br />
        <input type="password" name="password" placeholder="Password" required />
        <br />
        <button type="submit">Login</button>
    </form>

    <p>Or login using:</p>
    <a href="@Endpoints.External.SignInGoogle">Continue with Google</a>
    <br />
    <a href="@Endpoints.External.SignInMicrosoft">Continue with Microsoft</a>
</body>
</html>
