@page
@using Sven.Configurations;
@using Sven.PageModels;
@model Sven.Pages.Connect.SignInModel
@{
    Layout = "_ConnectLayout";
}
@section Styles {
    <link rel="stylesheet" href="@StylesScriptNames.ConnectSignMin" />
}
<div class="connect-wrapper">
    <div class="connect-card">
        <div class="logo-container">
            <img src="/images/logo.png" alt="Sven logo" class="logo" />
        </div>
        <h2>@Model.Text.Welcome</h2>

        @if (Model.CurrentModel.ErrorMessage != null)
        {
            <div class="error">@Model.CurrentModel.ErrorMessage</div>
        }

        <form method="post">
            <input type="text" name="@AuthConstants.OAuth.FieldNames.Username" placeholder="@Model.Text.Username" required autocomplete="on" />
            <br />
            <input type="password" name="@AuthConstants.OAuth.FieldNames.Password" placeholder="@Model.Text.Password" required />
            <br />
            <input type="hidden" name="@AuthConstants.OAuth.FieldNames.Mode" value="@Model.CurrentModel.Mode" />
            <button type="submit" asp-page-handler="Login">@Model.Text.Login</button>
        </form>

        <div class="divider">@Model.Text.Or</div>

        @foreach (ExternalLoginPageModel login in Model.CurrentModel.ExternalLogins)
        {
            @if (login.IsSignInEnabled)
            {
                <a class="social-button @login.CssClass" href="@login.SignInLink">@Model.Text.SignInWith @login.ProviderName</a>
            }
        }

        <div class="links">
            <a href="@Endpoints.Connect.ForgotPassword">@Model.Text.ForgotPassword</a>
            <span>|</span>
            <a href="@Endpoints.Connect.SignUp">@Model.Text.SignUp</a>
        </div>
    </div>
</div>
