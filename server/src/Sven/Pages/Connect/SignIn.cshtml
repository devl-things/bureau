@page
@using Sven.Configurations;
@using Sven.PageModels.ExternalLogins
@model Sven.Pages.Connect.SignInModel
@{
    Layout = "_SignLayout";
}

@section Header {
    <h2>@Model.Text.Welcome</h2>
}

@await Html.PartialAsync("_ErrorMessage", Model.CurrentModel.ErrorMessage)

<form method="post">
    <input type="text" name="@AuthConstants.PropertyNames.Username" placeholder="@Model.Text.UsernameOrEmail" required autocomplete="on" />
    <br />
    <input type="password" name="@AuthConstants.PropertyNames.Password" placeholder="@Model.Text.Password" required />
    <br />
    <input type="hidden" name="@AuthConstants.PropertyNames.Mode" value="@Model.CurrentModel.Mode" />
    <button type="submit" asp-page-handler="Login">@Model.Text.Login</button>
</form>

<div class="divider">@Model.Text.Or</div>

@await Html.PartialAsync("_ExternalLogins", new ExternalLoginsViewModel
{
    ExternalLogins = Model.CurrentModel.ExternalLogins,
    PrefixText = Model.Text.SignInWith
})

@section Footer {
    <div class="links">
        <a href="@Endpoints.Connect.ForgotPassword">@Model.Text.ForgotPassword</a>
        <span>|</span>
        <a href="@Endpoints.Connect.SignUp">@Model.Text.SignUp</a>
    </div>
}