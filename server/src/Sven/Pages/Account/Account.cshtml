@page "/account"
@using Sven.PageModels.Account
@model Sven.Pages.Account.AccountModel
@{
    Layout = "_SvenLayout";
}

@if (TempData.TryGetValue(TempDataNames.SuccessMessage, out object? msg)
    && msg is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="sven-card">
    <div class="sven-card-header">
        <h5 class="mb-0">@Model.T9n.LblAccount</h5>
    </div>
    <div class="card-body p-2">
        <div class="row mb-3">
            <div class="col-4 fw-semibold">@Model.T9n.LblEmail:</div>
            <div class="col-8">@Model.CurrentUser.DisplayName</div>
        </div>
        <div class="row mb-3">
            <div class="col-4 fw-semibold">@Model.T9n.LblUsername:</div>
            <div class="col-8">@Model.CurrentUser.Username</div>
        </div>
        <div class="row mb-0">
            <div class="col-4 fw-semibold">@Model.T9n.LblPassword:</div>
            <div class="col-8">
                <a class="btn btn-outline-primary btn-sm" href="/account/change-password">
                    @Model.T9n.BtnChangePassword
                </a>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_LinkedIdentities", Model.LinkedIdentitiesViewModel)


