@page "/account"
@model Sven.Pages.Account.AccountModel
@{
    Layout = "_SvenLayout";
}

<h2>@Model.Text.Title</h2>

@if (TempData[TempDataNames.SuccessMessage] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="card mb-4" style="max-width: 800px;">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-4 fw-semibold">@Model.Text.LblEmail:</div>
            <div class="col-8">@Model.CurrentUser.DisplayName</div>
        </div>
        <div class="row mb-3">
            <div class="col-4 fw-semibold">@Model.Text.LblUsername:</div>
            <div class="col-8">@Model.CurrentUser.Username</div>
        </div>
        <div class="row mb-0">
            <div class="col-4 fw-semibold">@Model.Text.LblPassword:</div>
            <div class="col-8">
                <a class="btn btn-outline-primary btn-sm" href="/account/change-password">
                    @Model.Text.BtnChangePassword
                </a>
            </div>
        </div>
    </div>
</div>
