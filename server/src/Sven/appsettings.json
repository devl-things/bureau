{
  "Auth": {
    "AuthorizationCodeLifetime": "00:05:02"
  },
  "Jwt": {
    "IdTokenLifetime": "00:05:02",
    "RefreshTokenLifetime": "30.00:00:02",
    "AccessTokenLifetime": "01:00:02"
  },
  "RateLimiting": {
    "TokenPermitLimit": 10,
    "TokenWindowSeconds": 60,
    "AuthorizePermitLimit": 20,
    "AuthorizeWindowSeconds": 60,
    "SignInPermitLimit": 10,
    "SignInWindowSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
