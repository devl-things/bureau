{
  "Admin": {
    "CurrentApp": "chores",
    "Apps": [
      {
        "Key": "bureau",
        "Title": "Bureau",
        "Url": "https://bureau.domain/admin",
        "Icon": "home"
      },
      {
        "Key": "chores",
        "Title": "Chores",
        "Url": "https://chores.domain/admin",
        "Icon": "checklist"
      },
      {
        "Key": "items",
        "Title": "Items",
        "Url": "https://items.domain/admin",
        "Icon": "box"
      }
    ]
  },
  "AppRuntime": {
    "Environment": "dev",
    "Version": "local",
    "DefaultApiKey": "choresApiBase",
    "ApiBaseUrls": {
      "choresApiBase": "http://localhost:5000"
    }
  },
  "Auth": {
    "Mode": "None"
  },
  "Frontend": {
    "UseViteDevServer": false,
    "BundlesPublicPath": "/admin/assets",
    "Bundles": {
      "chores-admin": "/src/entries/chores-admin.ts"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
