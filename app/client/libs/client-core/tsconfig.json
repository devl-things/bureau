{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false
    },
    "include": [
        "src"
    ]
}