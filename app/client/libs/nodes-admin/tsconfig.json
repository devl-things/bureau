{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": [
            "DOM",
            "ES2022"
        ],
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "paths": {
            "@bureau/client-core": [
                "../client-core/src/index.ts"
            ],
            "@bureau/nodes-core": [
                "../../../shared/nodes-core/src/index.ts"
            ]
        },
        "noEmit": true,
        "emitDeclarationOnly": false
    },
    "include": [
        "src"
    ]
}
