# Build context: repo root
# Build: docker build -f app/client/apps/bureau-web/Dockerfile -t bureau-web .

# ── Stage 1: build the SPA ─────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /repo

RUN npm install -g pnpm@latest

# Copy workspace manifests first (layer-cache friendly)
COPY app/package.json app/pnpm-lock.yaml app/pnpm-workspace.yaml ./app/

# Copy all workspace source
COPY app/client ./app/client
COPY app/shared  ./app/shared

WORKDIR /repo/app

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @bureau/bureau-web build

# ── Stage 2: serve with Nginx ──────────────────────────────────────────────────
FROM nginx:alpine AS serve

# Copy built SPA
COPY --from=build /repo/app/client/apps/bureau-web/dist /usr/share/nginx/html

# Copy template config (runtime config.json is generated by entrypoint from this)
COPY app/client/apps/bureau-web/public/config.template.json \
     /usr/share/nginx/html/config.template.json

# Nginx site config: SPA routing + no-cache on config.json
COPY app/client/apps/bureau-web/nginx.conf /etc/nginx/conf.d/default.conf

# Entrypoint: run envsubst before nginx starts
COPY app/client/apps/bureau-web/docker-entrypoint.sh \
     /docker-entrypoint.d/40-bureau-config.sh
RUN chmod +x /docker-entrypoint.d/40-bureau-config.sh
